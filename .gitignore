# Runtime state — never part of the deployed repo, lives under /home/pi/sitestream on the device
*.log
config.env
schedule.json
.manifest_hash
.schedule_updated

# pi-portal (standalone-mode local portal) — source is tracked here; only
# build output and installed deps are regenerated (npm run build in each of
# server/ and web/) and excluded, same as any other Node project.
pi-portal/server/dist/
pi-portal/server/node_modules/
pi-portal/web/node_modules/
pi-portal/web-dist/
